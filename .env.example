# =============================================================================
# Enterprise RAG — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Application ---
APP_NAME=enterprise-rag
APP_ENV=development
LOG_LEVEL=INFO

# --- Security ---
# In development: if left empty, a random key is generated per-process.
# In staging/production: REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_rag
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/enterprise_rag

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enterprise_documents

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Embeddings ---
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBEDDING_DIMENSION=1024

# --- LLM ---
# Uses OpenRouter (OpenAI-compatible API) for chat completions
LLM_BASE_URL=
# Your API key 
LLM_API_KEY=your-api-key-here
LLM_MODEL=

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ---
TOP_K=5

# --- File Storage ---
UPLOAD_DIR=data/uploads

# --- Email ---
EMAIL_PROVIDER_MODE=sandbox

# --- External Tool Providers ---
WEB_PROVIDER=sandbox
CALENDAR_PROVIDER_MODE=sandbox
