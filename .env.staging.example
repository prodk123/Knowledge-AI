# =============================================================================
# Enterprise RAG — Staging Environment Variables
# =============================================================================
# Copy this to .env.staging and supply real values.
# NEVER commit .env.staging \u2014 it is listed in .gitignore.
#
# Generate a secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# --- Application ---
APP_NAME=enterprise-rag-staging
APP_ENV=staging
LOG_LEVEL=INFO

# --- Security (REQUIRED in staging \u2014 app will refuse to start without it) ---
SECRET_KEY=REPLACE_WITH_64_HEX_CHARS_FROM_secrets_token_hex_32

# --- PostgreSQL (staging uses its own isolated database) ---
POSTGRES_USER=rag_staging
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=enterprise_rag_staging
DATABASE_URL=postgresql+asyncpg://rag_staging:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/enterprise_rag_staging

# --- Redis ---
REDIS_URL=redis://redis:6379/1

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
# Isolated staging collection \u2014 does NOT share data with production
QDRANT_COLLECTION=enterprise_documents_staging

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Embeddings ---
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=REPLACE_WITH_MODEL_NAME
EMBEDDING_DIMENSION=2048

# --- LLM (never use production key here) ---
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=REPLACE_WITH_STAGING_API_KEY
LLM_MODEL=meta/llama-3.2-11b-vision-instruct

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ---
TOP_K=5

# --- File Storage (staging uses its own volume) ---
UPLOAD_DIR=data/uploads

# --- Email (sandbox only in staging \u2014 no real emails sent) ---
EMAIL_PROVIDER_MODE=sandbox

# --- External Tool Providers (sandbox in staging) ---
WEB_PROVIDER=sandbox
CALENDAR_PROVIDER_MODE=sandbox
